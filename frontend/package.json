{
  "name": "loandesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:single": "vite --mode single --port 5173 --strictPort",
    "dev:multi": "vite --mode multi --port 5174 --strictPort",
    "build:single": "tsc --noEmit && vite build --mode single --outDir dist/single",
    "build:multi": "tsc --noEmit && vite build --mode multi --outDir dist/multi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
