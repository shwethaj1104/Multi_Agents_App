# Public browser configuration only. Never put provider/database credentials here.
VITE_SINGLE_AGENT_API_BASE_URL=/api/single-agent/v1
VITE_MULTI_AGENT_API_BASE_URL=/api/multi-agent/v1
# Optional startup preference; users can change it with the header switch.
VITE_REVIEW_MODE=single_agent
# Optional local proxy destinations (server-side Vite configuration).
SINGLE_AGENT_API_PROXY_TARGET=http://127.0.0.1:8011
MULTI_AGENT_API_PROXY_TARGET=http://127.0.0.1:8012
