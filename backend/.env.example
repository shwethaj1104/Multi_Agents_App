# LoanDesk local development. Keep this file private.
# Credentials: fill in the blank values yourself. No quotation marks are needed
# unless your value contains spaces; percent-encode special characters in URI credentials.
OPENAI_API_KEY=
MONGODB_URI=
MONGODB_DATABASE=loandesk
LANGSMITH_API_KEY=

# Current application setting. Launch scripts override the mode per process.
LOANDESK_REVIEW_MODE=single_agent

# Selected low-cost profile for the upcoming agent integration.
# Live calls require this separate flag AND a key. Leave disabled during offline development.
LOANDESK_LIVE_MODEL_CALLS_ENABLED=false
# The app uses the MongoDB database configured above.
LOANDESK_STORAGE_BACKEND=mongodb
# Model usage allowances are checked before every call; provider billing remains authoritative.
LOANDESK_MODEL=gpt-5.6-luna
LOANDESK_REASONING_EFFORT=low
LOANDESK_MAX_OUTPUT_TOKENS=2048
LOANDESK_MAX_MODEL_CALLS_PER_REVIEW=10
LOANDESK_MAX_FOLLOW_UP_ROUNDS=1
LOANDESK_MODEL_MAX_RETRIES=0
LOANDESK_EXPERIMENT_CONCURRENCY=1
LOANDESK_SMOKE_TEST_CASES=5
LOANDESK_LLM_JUDGE_ENABLED=false
# Application reservation allowances; NOT provider billing caps.
LOANDESK_REVIEW_BUDGET_USD=0.10
LOANDESK_SESSION_BUDGET_USD=2.00

# Leave tracing off until the key, destination and integration are ready.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Current agent-based workspace: create one LoanDesk Observability agent and copy its ID.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
# Older project-based workspace: remove the two agent variables above and use instead:
# LANGSMITH_PROJECT=loandesk-development
